# Benzene: density-fitted PBE0 measures DFT grid work and hybrid exchange.
memory 4 GB
molecule benzene {
0 1
C  1.397000  0.000000  0.000000
C  0.698500  1.209837  0.000000
C -0.698500  1.209837  0.000000
C -1.397000  0.000000  0.000000
C -0.698500 -1.209837  0.000000
C  0.698500 -1.209837  0.000000
H  2.481000  0.000000  0.000000
H  1.240500  2.148609  0.000000
H -1.240500  2.148609  0.000000
H -2.481000  0.000000  0.000000
H -1.240500 -2.148609  0.000000
H  1.240500 -2.148609  0.000000
units angstrom
symmetry c1
no_reorient
no_com
}
set {
  basis cc-pvtz
  scf_type df
  guess sad
  e_convergence 1e-9
  d_convergence 1e-7
  ints_tolerance 1e-12
  dft_radial_points 75
  dft_spherical_points 302
  dft_pruning_scheme robust
}
import time
import resource
import psi4
print(f'BENCHMARK_CORE {psi4.core.__file__}')
start = time.perf_counter()
result, wfn = energy('pbe0', return_wfn=True)
elapsed = time.perf_counter() - start
print(f'BENCHMARK_RESULT {result:.14f} {elapsed:.9f} {wfn.basisset().nbf()}')
print(f"BENCHMARK_ITERATIONS {int(wfn.variable('SCF ITERATIONS'))}")
print(f'BENCHMARK_RSS {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}')

# Benzene: density-fitted MP2 measures matrix contractions and correlation.
memory 4 GB
molecule benzene {
0 1
C  1.397000  0.000000  0.000000
C  0.698500  1.209837  0.000000
C -0.698500  1.209837  0.000000
C -1.397000  0.000000  0.000000
C -0.698500 -1.209837  0.000000
C  0.698500 -1.209837  0.000000
H  2.481000  0.000000  0.000000
H  1.240500  2.148609  0.000000
H -1.240500  2.148609  0.000000
H -2.481000  0.000000  0.000000
H -1.240500 -2.148609  0.000000
H  1.240500 -2.148609  0.000000
units angstrom
symmetry c1
no_reorient
no_com
}
set {
  basis cc-pvqz
  scf_type df
  mp2_type df
  freeze_core true
  guess sad
  e_convergence 1e-9
  d_convergence 1e-7
  ints_tolerance 1e-12
}
import time
import resource
import psi4
print(f'BENCHMARK_CORE {psi4.core.__file__}')
start = time.perf_counter()
reference, wfn = energy('hf', return_wfn=True)
scf_elapsed = time.perf_counter() - start
start = time.perf_counter()
result = energy('mp2', ref_wfn=wfn)
elapsed = time.perf_counter() - start
print(f'BENCHMARK_REFERENCE {reference:.14f} {scf_elapsed:.9f}')
print(f'BENCHMARK_RESULT {result:.14f} {elapsed:.9f} {wfn.basisset().nbf()}')
print(f"BENCHMARK_ITERATIONS {int(wfn.variable('SCF ITERATIONS'))}")
print(f'BENCHMARK_RSS {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}')
